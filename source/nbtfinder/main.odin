WindowSpecifications :: struct {
  title : string,
  width : i32,
  height : i32,
}
window_specs : WindowSpecifications : {
  title = "nbtfinder\x00",
  width = 400,
  height = 600
}
#assert (window_specs.title[len(window_specs.title)-1] == 0)

AppState :: struct {
  mu_context : mu.Context
}

init :: proc(appstate : ^AppState) -> (mu_context : ^mu.Context, ok : bool) {

  mu.init(&appstate.mu_context)

  mu_context = &appstate.mu_context;
  mu_context.text_width  = mu.default_atlas_text_width
  mu_context.text_height = mu.default_atlas_text_height

  return mu_context, true
}




mca_sector_size :: 4096
mca_chunk_count :: 1024

Pos2D :: struct {
  x : i32,
  z : i32
}

PosChunk :: distinct Pos2D
PosBlock :: distinct Pos2D
PosRegion :: distinct Pos2D

Mca_Location :: distinct u32be

McaLocation_getLenghtAndOffset :: proc(mca_location_entry: Mca_Location) -> (offset: u32, lenght: u8) {
  offset = u32(mca_location_entry >> 8)
  lenght = u8(mca_location_entry & 0xff)
  return
}


Mca_File :: struct {
  header_location : [mca_chunk_count]Mca_Location,
  timestamp_header : [mca_chunk_count]u32,

  sectors : [][mca_sector_size]u8

}

Nbt_Reader :: struct {
  is_big_endian_file : bool,
 
  bytes : []u8,
  index : uint,

  bytes_for_arrays : [dynamic]i8,
  ints_for_arrays : [dynamic]i32,
  longs : [dynamic]i64,
  doubles : [dynamic]f64,
}

// NOTE(dendo): for Nbt_readField and Nbt_readFieldAndConvert,
// its quite frustating that they take and $type : typeid.
// The functions generated by the compiler are way too similar, specialy on x86.
// Some binary space could be saved by thinking of a better method
Nbt_readFieldEndianSpecified :: proc(reader : ^Nbt_Reader, $type : typeid) -> (ret : type) {
  // assert that type is endian specified
  assert(len(reader.bytes)-int(reader.index + size_of(type)) >= 0, "nbt passer failed")

  ret = intrinsics.unaligned_load(cast(^type)&reader.bytes[reader.index])
  reader.index += size_of(type)
  return
}

// HACK(dendo): Is it really the best to convert the field to plataform endian right away?
// maybe store in big endian anyway and convert on use?
Nbt_readField :: proc(reader : ^Nbt_Reader, $type : typeid) -> (ret : type) {
  // NOTE: assert that type is not endian specified. Compiler should error without a nice message
  if (reader.is_big_endian_file) {
    when type == i8 {
      type_to_read :: i8
    } else when type == i16 {
      type_to_read :: i16be
    } else when type == u16 {
      type_to_read :: u16be
    } else when type == i32 {
      type_to_read :: i32be
    } else when type == i64 {
      type_to_read :: i64be
    } else when type == f32 {
      type_to_read :: f32be
    } else when type == f64 {
      type_to_read :: f64be
    }
    ret = type(Nbt_readFieldEndianSpecified(reader, type_to_read))
    return ret
  } else {
    when type == i8 {
      type_to_read :: i8
    } else when type == i16 {
      type_to_read :: i16le
    } else when type == u16 {
      type_to_read :: u16le
    } else when type == i32 {
      type_to_read :: i32le
    } else when type == i64 {
      type_to_read :: i64le
    } else when type == f32 {
      type_to_read :: f32le
    } else when type == f64 {
      type_to_read :: f64le
    }
    ret = type(Nbt_readFieldEndianSpecified(reader, type_to_read))
    return ret
  }
}

// NOTE: assumes lenght : u16be before the string itself
Nbt_readString :: proc(reader : ^Nbt_Reader) -> (ret : string) {

  string_lenght := Nbt_readField(reader, u16)

  assert(len(reader.bytes)-int(reader.index + uint(string_lenght)) >= 0, "nbt passer failed")

  bytes_string := reader.bytes[reader.index:reader.index+uint(string_lenght)]
  // TODO(dendo): it seams a bit dumb to allocate a string for every field when most of the fields repeat the sames strings
  // maybe implement a hash table with "known strings" and store them that way
  str, err := strings.clone_from_bytes(bytes_string)
  if err != nil {
    fmt.printfln("\nError: %v", err)
  }

  assert(err == nil, "allocation failed")

  reader.index += uint(string_lenght)
  return str
}

// NOTE: Mutates reader arrays
Nbt_readArray :: proc(reader : ^Nbt_Reader, $type : typeid) {

  size := Nbt_readField(reader, i32)

  when type == i8 {
    array := reader.bytes_for_arrays
  } else when type == i32 {
    array := reader.ints_for_arrays
  } else when type == i64 {
    array := reader.longs
  }

  reserve(&array, len(array)+int(size))


  // NOTE(dendo): because the values could be unaligned, they have to be read one by one sadly, AFAIK
  // NOTE(dendo): x86 doesn't seem to care too much about unaligned reads, so there might be some optimizations here
  for i := 0; i < int(size); i += 1 {
    value := Nbt_readField(reader, type)
    array[i] = value
  }
}


// NOTE(dendo): currently, this assumes Java nbt, i.e. big endian nbt
Nbt_decode :: proc(nbt_bytes : []u8) {
  reader : Nbt_Reader = {
    bytes = nbt_bytes,
    index = 0,
    // TODO(dendo): find better starter size for dynamic arrays
    // TODO(dendo): test performance of context.temp_allocator
    bytes_for_arrays = make([dynamic]i8, 0, 64, context.temp_allocator),
    ints_for_arrays = make([dynamic]i32, 0, 64, context.temp_allocator),
    longs = make([dynamic]i64, 0, 64, context.temp_allocator),
    doubles = make([dynamic]f64, 0, 64, context.temp_allocator)
  }

  nested_compound_tags := 1

  for {
    current_ptr : [^]u8 = mem.ptr_offset(slice.as_ptr(reader.bytes), reader.index)
    tag : Nbt_Tag
    tag.type = Nbt_TagType(reader.bytes[reader.index])
    reader.index += 1

    if nested_compound_tags > 0 && tag.type != .End {
      // DESC: read key string after tag

      // NOTE(dendo): does every tag (apart from lists) has a string name?? it seams so but you can't be sure
      // minecraft.wiki says that only tags inside compound tags have names, but the root tag is always a compound tag
      // maybe on bedrock nbt this is not true?

      tag.name = Nbt_readString(&reader)
      fmt.println(tag.name)

    }

    // DESC: read payload
    switch tag.type {
      case .End:
        // TODO:
        fmt.print("Compound")

      case .Byte:
        tag.value.byte = i8(reader.bytes[reader.index])
        reader.index += 1

      case .Short:
        short := Nbt_readField(&reader, i16)
        tag.value.short = i16(short)

      case .Int:
        integer := Nbt_readField(&reader, i32)
        tag.value.integer = i32(integer)

      case .Long:
        long := Nbt_readField(&reader, i64)

        assert(len(reader.longs) < (2 << 32))
        tag.value.long = LongIndex(len(reader.longs))

        append(&reader.longs, i64(long))

      case .Float:
        float := Nbt_readField(&reader, f32)
        tag.value.float = f32(float)

      case .Double:
        double := Nbt_readField(&reader, f64)

        assert(len(reader.doubles) < (2 << 32))
        tag.value.double = DoubleIndex(len(reader.doubles))

        append(&reader.doubles, f64(double))

      case .ByteArray:
        Nbt_readArray(&reader, i8)

      case .String:
        // SEMI TODO:
        str := Nbt_readString(&reader)
        fmt.println(str)
        tag.value.str = str

      case .List:
        // SUPER  TODO:
        tag := Nbt_TagType(reader.bytes[reader.index])
        //nbt_readList(&reader, tag)

      case .Compound:
        // TODO:
        fmt.print("Compound")

      case .IntArray:
        Nbt_readArray(&reader, i32)

      case .LongArray:
        Nbt_readArray(&reader, i64)
    }
  }


  free_all(context.temp_allocator)
}

Mca_readAndDecompressChunk :: proc(file : ^os.File, mca_loc : Mca_Location) {
  offset, sector_lenght := McaLocation_getLenghtAndOffset(mca_loc)

  byte_offset : i64 = i64(offset)*mca_sector_size
  byte_lenght := mca_sector_size*int(sector_lenght)

  chunk_data := make([]u8, byte_lenght)
  defer delete(chunk_data)
  {
    n, err := os.read_at(file, chunk_data, byte_offset)
    if err != os.ERROR_NONE {
      fmt.printfln("Error reading chunk data")
      return
    }
    assert(n != 0 && n%mca_sector_size == 0, "currupt mca file")
  }

  lenght := slice.reinterpret([]u32be, chunk_data)[0]
  compression_type := slice.reinterpret([]u8, chunk_data)[4]

  chunk_bytes : []u8 = chunk_data[5:4+lenght]
  nbt_buffer : bytes.Buffer
  defer bytes.buffer_destroy(&nbt_buffer)
  {
    err := zlib.inflate(input=chunk_bytes, buf=&nbt_buffer)

    if err != nil {
      fmt.printfln("\nError: %v", err)
      return
    }
  }

  nbt_bytes := bytes.buffer_to_bytes(&nbt_buffer)

  Nbt_decode(nbt_bytes)

}

Mca_read :: proc(filename : string) {
  file, err := os.open(filename)
  defer os.close(file)
  if err != os.ERROR_NONE {
    fmt.printfln("Error opening file %s", err)
    return
  }


  sector : [mca_sector_size]u8

  mca : Mca_File
  n : int

  n, err = os.read(file, slice.to_bytes(mca.header_location[:]))
  if err != os.ERROR_NONE {
    fmt.printfln("Error reading 1st header on %s. Error: %s", filename, err)
    return
  }

  n, err = os.read(file, slice.to_bytes(mca.timestamp_header[:]))
  if err != os.ERROR_NONE {
    fmt.printfln("Error reading 2st header on %s. Error: %s", filename, err)
    return
  }

  for mca_loc in mca.header_location {
    if (mca_loc != 0) {
      Mca_readAndDecompressChunk(file, mca_loc)

      break
    }
  }


}

