package nbtfinder

import "base:intrinsics"
import "base:runtime"
import "core:fmt"
import "core:mem"
import "core:simd"
import "core:slice"
import "core:strings"
import "core:time"


NBT_Type :: enum u8 {
  End       = 0x00,
  Byte      = 0x01,
  Short     = 0x02,
  Int       = 0x03,
  Long      = 0x04,
  Float     = 0x05,
  Double    = 0x06,
  ByteArray = 0x07,
  String    = 0x08,
  List      = 0x09,
  Compound  = 0x0A,
  IntArray  = 0x0B,
  LongArray = 0x0C,
}

// NOTE: Nbt actualy doesn't support arrays with more than (2^31 - 1) elemments becuase of Java, so this is safe
ArrayView :: struct {
  start_index : u32,
  count : i32
}

BytesView :: distinct ArrayView
IntsView  :: distinct ArrayView
LongsView :: distinct ArrayView
TagsView  :: distinct ArrayView

NBT_Value :: struct #raw_union {
  byte : i8,
  short : i16,
  integer : i32,
  long : i64,
  float : f32,
  double : f64,
  byte_array : BytesView,
  str : string, // to be changed
  list : TagsView, // NOTE(dendo): this is probably not the best, but good enought
  compound : TagsView,
  int_array : IntsView,
  long_array : LongsView,
}

NBT_Tag :: struct {
  // NOTE(dendo): nameless Nbt_Tag have name == 0
  name : string,
  type : NBT_Type,
  value : NBT_Value,
}

NBT_Decoded_Header :: struct {
  // NOTE: children are stored togheter
  root_tag_index : u32,
  tags : []NBT_Tag,

  // NOTE(dendo): these slices only contain data from the arrays Tagtypes themselves.
  // an actual long tag has it value stored inplace
  bytes : []i8,
  ints : []i32,
  longs : []i64,

  //// NOTE: points to tags
  //childrens : []TagsView,
  //lists : []Nbt_List,


  // NOTE(dendo): in practice the data from the slices is stored right after the header
  // arrays : [?]u8
}

NBT_Decoder :: struct {
  is_big_endian_file : bool,
 
  raw_data : []u8,
  index : uint,

  bytes : [dynamic]i8,
  ints : [dynamic]i32,
  longs : [dynamic]i64,

  tags : [dynamic]NBT_Tag,
}

// NOTE(dendo): for read_tag_value_number and read_tag_value_number_endian_specified,
// its quite frustating that they take and $type : typeid.
// The functions generated by the compiler are way too similar, specialy on x86.
// Some binary space could be saved by thinking of a better method
read_tag_value_number_endian_specified :: proc(decoder : ^NBT_Decoder, $type : typeid) -> (ret : type) {
  // WARN: assert that type is endian specified, this is not tested by the compiler
  assert(len(decoder.raw_data)-int(decoder.index + size_of(type)) >= 0, "nbt passer failed")

  ret = intrinsics.unaligned_load(cast(^type)&decoder.raw_data[decoder.index])
  decoder.index += size_of(type)
  return
}

// HACK(dendo): Is it really the best to convert the field to plataform endian right away?
// maybe store in big endian anyway and convert on use?
read_tag_value_number :: proc(decoder : ^NBT_Decoder, $type : typeid) -> (ret : type) {
  // NOTE: assert that type is not endian specified. Compiler should error without a nice message
  if (decoder.is_big_endian_file) {
    when type == i8 {
      type_to_read :: i8
    } else when type == i16 {
      type_to_read :: i16be
    } else when type == u16 {
      type_to_read :: u16be
    } else when type == i32 {
      type_to_read :: i32be
    } else when type == i64 {
      type_to_read :: i64be
    } else when type == f32 {
      type_to_read :: f32be
    } else when type == f64 {
      type_to_read :: f64be
    }
    ret = type(read_tag_value_number_endian_specified(decoder, type_to_read))
    return ret
  } else {
    when type == i8 {
      type_to_read :: i8
    } else when type == i16 {
      type_to_read :: i16le
    } else when type == u16 {
      type_to_read :: u16le
    } else when type == i32 {
      type_to_read :: i32le
    } else when type == i64 {
      type_to_read :: i64le
    } else when type == f32 {
      type_to_read :: f32le
    } else when type == f64 {
      type_to_read :: f64le
    }
    ret = type(read_tag_value_number_endian_specified(decoder, type_to_read))
    return ret
  }
}

// NOTE: assumes lenght : u16 before the string itself
read_tag_value_string :: proc(decoder : ^NBT_Decoder) -> (ret : string) {
  string_lenght := read_tag_value_number(decoder, u16)

  assert(len(decoder.raw_data)-int(decoder.index + uint(string_lenght)) >= 0, "nbt passer failed")

  bytes_string := decoder.raw_data[decoder.index:decoder.index+uint(string_lenght)]
  // TODO(dendo): it seams a bit dumb to allocate a string for every field when most of the fields repeat the sames strings
  // maybe implement a hash table with "known strings" and store them that way
  str, err := strings.clone_from_bytes(bytes_string, context.allocator)
  if err != nil {
    fmt.printfln("\nError: %v", err)
  }

  assert(err == nil, "allocation failed")

  decoder.index += uint(string_lenght)
  return str
}

read_tag_value_list_array_simd :: #force_inline proc(decoder: ^NBT_Decoder, $simd_type: typeid, $should_byte_swap: bool) -> (view: ArrayView) {
  size := read_tag_value_number(decoder, i32)
  if (size == 0) {
    view.start_index = 0
    view.count = 0
    return
  }
  assert(size >= 0)
  elem_type :: intrinsics.type_elem_type(simd_type)

  assert(len(decoder.raw_data)-int(decoder.index + uint(size*size_of(elem_type))) >= 0, "nbt passer failed")

  when elem_type == i8 {
    array_ptr := &decoder.bytes
  } else when elem_type == i32 {
    array_ptr := &decoder.ints
  } else when elem_type == i64 {
    array_ptr := &decoder.longs
  }

  assert(len(array_ptr) <= (1 << 32)-1)
  view.start_index = u32(len(array_ptr));
  view.count = size;

  dst_index := len(array_ptr)

  resize(array_ptr, len(array_ptr)+int(size))

  end_point := decoder.index + uint(size*size_of(elem_type))

  // stop before last vector
  for ; decoder.index < end_point-size_of(simd_type); decoder.index += size_of(simd_type) {
    vec := intrinsics.unaligned_load(cast(^simd_type)&decoder.raw_data[decoder.index])
    when should_byte_swap {
      vec = simd.byte_swap(vec)
    }

    intrinsics.unaligned_store(cast(^simd_type)&array_ptr[dst_index], vec)
    dst_index += size_of(simd_type)/size_of(elem_type)
  }

  // load last vector
  assert(end_point - decoder.index <= size_of(simd_type))
  bytes_to_load := (end_point-decoder.index)
  elems_to_load := bytes_to_load / size_of(intrinsics.type_elem_type(simd_type))

  test : simd_type = elem_type(elems_to_load)
  iota := simd.iota(simd_type)
  mask := simd_type(simd.lanes_lt(iota, test))

  vec := simd.masked_load(&decoder.raw_data[decoder.index], cast(simd_type)0, mask)
  when should_byte_swap {
    vec = simd.byte_swap(vec)
  }

  simd.masked_store(&array_ptr[dst_index], vec, mask)

  decoder.index += bytes_to_load

  return 
}

// NOTE: Mutates decoder arrays
read_tag_value_array :: proc(decoder : ^NBT_Decoder, $type : typeid) -> (view : ArrayView) {
  size := read_tag_value_number(decoder, i32)

  assert(len(decoder.raw_data)-int(decoder.index + uint(size*size_of(type))) >= 0, "nbt passer failed")

  when type == i8 {
    // NOTE(dendo): this case, the unaligned read proc is not necessary in any architecture
    // because of the nature of the byte
    array_ptr := &decoder.bytes
  } else when type == i32 {
    array_ptr := &decoder.ints
  } else when type == i64 {
    array_ptr := &decoder.longs
  }

  reserve(array_ptr, len(array_ptr)+int(size))

  assert(len(array_ptr) <= (1 << 32)-1)

  view.start_index = u32(len(array_ptr));
  view.count = size;

  // NOTE(dendo): because the values could be unaligned, they have to be read one by one sadly, AFAIK
  // NOTE(dendo): x86 doesn't seem to care too much about unaligned reads, so there might be some optimizations here
  for i := 0; i < int(size); i += 1 {
    value := read_tag_value_number(decoder, type)
    append(array_ptr, value)
  }

  return
}


ReadResult :: enum {
  ok, end, unknown_type, out_of_bounds
}

read_tag_named :: proc(decoder : ^NBT_Decoder, tag : ^NBT_Tag) -> (res: ReadResult) {
  current_ptr : [^]u8 = mem.ptr_offset(slice.as_ptr(decoder.raw_data), decoder.index) // for easier debuging

  tag.type = NBT_Type(decoder.raw_data[decoder.index])
  decoder.index += 1

  if tag.type != .End {
    // DESC: read key string after tag

    // NOTE(dendo): does every tag (apart from lists) has a string name?? it seams so but you can't be sure
    // minecraft.wiki says that only tags inside compound tags have names, but the root tag is always a compound tag
    // maybe on bedrock nbt this is not true? It seams that there List could be the root.
    // Even so, the root tag, usualy has a name with size == 0

    tag.name = read_tag_value_string(decoder)
    //fmt.println(tag.name)
  }

  return read_tag_value(decoder, tag)
}

read_tag_unnamed :: proc(decoder : ^NBT_Decoder, tag: ^NBT_Tag) -> (res: ReadResult) {
  current_ptr : [^]u8 = mem.ptr_offset(slice.as_ptr(decoder.raw_data), decoder.index) // for easier debuging
  tag.type = NBT_Type(decoder.raw_data[decoder.index])
  decoder.index += 1

  return read_tag_value(decoder, tag)
}

read_tag_value_compound :: proc(decoder : ^NBT_Decoder, tag: ^NBT_Tag) -> (res: ReadResult) {
  children := make([dynamic]NBT_Tag, 0, 4, context.temp_allocator)

  last_res : ReadResult = .ok
  for {
    temp_tag : NBT_Tag
    last_res = read_tag_named(decoder, &temp_tag)

    if (last_res == .ok) {
      append(&children, temp_tag)

    } else {
      break;
    }
  }

  assert(last_res != .ok)
  if last_res == .end {
    start_index := len(decoder.tags)
    children_amount := len(children)
    reserve(&decoder.tags, len(decoder.tags) + len(children))

    for i := 0; i < children_amount; i += 1 {
      append(&decoder.tags, children[i])
    }

    assert(start_index <= (1 << 32)-1)
    assert(children_amount <= (1 << 31)-1)

    tag.value.compound.start_index = u32(start_index)
    tag.value.compound.count = i32(children_amount)

    return .ok
  } else {
    return last_res
  }
}

// NOTE(dendo): this is a pretty lazy implementation, as data and performance is concerned
read_tag_value_list :: proc(decoder : ^NBT_Decoder, tag: ^NBT_Tag) -> (res: ReadResult) {
  list_tag_type := NBT_Type(decoder.raw_data[decoder.index])
  decoder.index += 1

  size := read_tag_value_number(decoder, i32)

  children := make([dynamic]NBT_Tag, 0, size, context.temp_allocator)

  last_res : ReadResult = .ok
  for i : i32 = 0; i < size; i += 1 {
    temp_tag : NBT_Tag
    temp_tag.type = list_tag_type

    last_res = read_tag_value(decoder, &temp_tag)

    if (last_res == .ok) {
      append(&children, temp_tag)
    } else {
      break;
    }
  }

  assert(last_res != .end)
  if last_res == .ok {
  // TODO(dendo): if size == 0, start_index = 0
    start_index := len(decoder.tags)
    children_amount := len(children)
    reserve(&decoder.tags, len(decoder.tags) + len(children))

    for i := 0; i < children_amount; i += 1 {
      append(&decoder.tags, children[i])
    }


    assert(start_index <= (1 << 32)-1)
    assert(children_amount <= (1 << 31)-1)

    tag.value.compound.start_index = u32(start_index)
    tag.value.compound.count = i32(children_amount)

    return .ok
  } else {
    return last_res
  }
}

read_tag_value :: proc(decoder : ^NBT_Decoder, tag: ^NBT_Tag) -> (res: ReadResult) {
  switch tag.type {
    case .End:
      return .end

    case .Byte:
      tag.value.byte = i8(decoder.raw_data[decoder.index])
      decoder.index += 1

    case .Short:
      tag.value.short = read_tag_value_number(decoder, i16)

    case .Int:
      tag.value.integer = read_tag_value_number(decoder, i32)

    case .Long:
      tag.value.long = read_tag_value_number(decoder, i64)

    case .Float:
      tag.value.float = read_tag_value_number(decoder, f32)

    case .Double:
      tag.value.double = read_tag_value_number(decoder, f64)

    case .ByteArray:
      tag.value.byte_array = read_byte_array(decoder)

    case .String:
      // SEMI TODO:
      str := read_tag_value_string(decoder)
      //fmt.println(str)
      tag.value.str = str

    case .List:
      // NOTE(dendo): yes, we are using recursion
      read_tag_value_list(decoder, tag)

    case .Compound:
      // NOTE(dendo): yes, we are using recursion
      read_tag_value_compound(decoder, tag)

    case .IntArray:
      tag.value.int_array = read_int_array(decoder)

    case .LongArray:
      tag.value.long_array = read_long_array(decoder)

    case:
      return .unknown_type
  }

  return .ok
}

@(thread_local) read_byte_array : proc(^NBT_Decoder) -> BytesView
@(thread_local) read_int_array : proc(^NBT_Decoder) -> IntsView
@(thread_local) read_long_array : proc(^NBT_Decoder) -> LongsView

// WARNING(dendo): bunch of template instantiation incoming!!!!!
// On a side note, having to manualy instantiate every possible combination
// really shows the amount of code that I'm generating here.
// TODO(dendo): verify if this bunch of proc instantiation is worth it,
// or if the branches aprouch is just better
read_byte_array_scalar :: proc (decoder: ^NBT_Decoder) -> BytesView {
  return BytesView(read_tag_value_array(decoder, i8))
}
read_int_array_scalar :: proc (decoder: ^NBT_Decoder) -> IntsView {
  return IntsView(read_tag_value_array(decoder, i32))
}
read_long_array_scalar :: proc (decoder: ^NBT_Decoder) -> LongsView {
  return LongsView(read_tag_value_array(decoder, i64))
}

read_byte_array_simd_128 :: proc (decoder: ^NBT_Decoder) -> BytesView {
  return BytesView(read_tag_value_list_array_simd(decoder, #simd[16]i8, false))
}

read_int_array_simd_128_swap :: proc (decoder: ^NBT_Decoder) -> IntsView {
  return IntsView(read_tag_value_list_array_simd(decoder, #simd[4]i32, true))
}
read_int_array_simd_128_noswap :: proc (decoder: ^NBT_Decoder) -> IntsView {
  return IntsView(read_tag_value_list_array_simd(decoder, #simd[4]i32, false))
}

read_long_array_simd_128_swap :: proc (decoder: ^NBT_Decoder) -> LongsView {
  return LongsView(read_tag_value_list_array_simd(decoder, #simd[2]i64, true))
}
read_long_array_simd_128_noswap :: proc (decoder: ^NBT_Decoder) -> LongsView {
  return LongsView(read_tag_value_list_array_simd(decoder, #simd[2]i64, false))
}

@(enable_target_feature="avx,avx2")
read_byte_array_simd_256 :: proc (decoder: ^NBT_Decoder) -> BytesView {
  return BytesView(read_tag_value_list_array_simd(decoder, #simd[32]i8, false))
}

@(enable_target_feature="avx,avx2")
read_int_array_simd_256_swap :: proc (decoder: ^NBT_Decoder) -> IntsView {
